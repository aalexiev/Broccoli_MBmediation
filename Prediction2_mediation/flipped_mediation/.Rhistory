modY_ASV <- ggplot(data = regrplot, aes(x = log(X.Eubacterium..ruminantium.group+1), y = log(SFN+1))) +
geom_point(aes(color = diet_Disacc_g)) +
stat_smooth(method = "lm", se = TRUE) +
ggtitle("SFN ~ Eubacterium group microbial abundance")
modY_ASV
ggarrange(modM, modY_ASV, modY_fib,
nrow = 1, ncol = 3)
setwd("/Users/alexieva/Documents/Projects/Analysis/broccoli project/01_explAnalysis/brocc_mediation_Rfiles/flipped_mediation/")
ggarrange(modM, modY_ASV, modY_fib,
nrow = 1, ncol = 3)
ggarrange(modM, modY_ASV, modY_fib,
nrow = 1, ncol = 3,
legend = "bottom")
ggarrange(modM, modY_ASV, modY_fib,
nrow = 1, ncol = 3,
legend = "bottom",
align = "h")
ggsave("ExamplePlot_rumironsfn_flippedmed.png",
height = 5, width = 15, dpi = 300)
