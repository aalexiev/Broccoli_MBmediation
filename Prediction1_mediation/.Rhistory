geom_smooth(se = TRUE, method = "lm") +
labs(title = paste0(M, " abundance ~ ", Y), x = Y,
y = paste0("log transformed ", M, " abundance"))
# make graphs of model Y
modY_ASV <- ggplot(data = regrplot, aes(x = M_vals, y = trans_X)) +
geom_point() +
stat_smooth(method = "lm", se = TRUE) +
labs(title = paste0(X, " ~ ", M, " abundance"), x = paste0(M, " abundance"),
y = paste0("log transformed ", X, " abundance"))
modY_diet <- ggplot(data = regrplot, aes(x = Y_vals, y = trans_X)) +
geom_point() +
stat_smooth(method = "lm", se = TRUE) +
labs(title = paste0(X, " ~ ", Y, " abundance"), x = Y,
y = paste0("log transformed ", X, " abundance"))
# combine and save graphs
g <- ggarrange(modM, modY_ASV, modY_diet,
nrow = 1, ncol = 3)
ggsave(paste0("/Users/alexieva/Documents/Projects/Analysis/broccoli project/01_explAnalysis/figstabs/med_plots/", M, "_", X, "_", Y, ".png"), g,
height = 5, width = 15, dpi = 300)
}
