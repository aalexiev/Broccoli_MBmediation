## basic lm
model.M.0 <- lm(f_Erysipelotrichaceae_ASV487 ~ quarts_totfib, med_input)
summary(model.M.0)
## glm negative binomial
model.M.1 <- glm.nb(f_Erysipelotrichaceae_ASV487 ~ quarts_totfib, med_input)
summary(model.M.1)
## log lm
model.M.2 <- lm(log(f_Erysipelotrichaceae_ASV487+1) ~ quarts_totfib, med_input)
